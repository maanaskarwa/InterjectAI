# Public LiveKit values only. Never place API secrets in Vite variables.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
# Use either a LiveKit Cloud sandbox ID or your own token endpoint.
VITE_LIVEKIT_SANDBOX_ID=
VITE_LIVEKIT_TOKEN_ENDPOINT=
VITE_LIVEKIT_AGENT_NAME=decision-window
VITE_DEFAULT_ROOM=decision-window-demo
