{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-window.local/events.schema.json",
  "title": "Decision Window room event",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "ts_ms", "payload"],
  "properties": {
    "type": {
      "enum": [
        "agent.state",
        "transcript.partial",
        "transcript.final",
        "research.started",
        "research.completed",
        "research.expired",
        "research.failed",
        "answer.card",
        "control.dismiss",
        "control.research",
        "control.speak",
        "control.stop"
      ]
    },
    "ts_ms": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  }
}
