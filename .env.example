# LiveKit Cloud — also add these three as encrypted Cloudflare Pages secrets
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=interject-build

# Inworld — rotated base64 API credential, without the `Basic ` prefix
INWORLD_API_KEY=

# Bright Data Discover API
BRIGHTDATA_API_TOKEN=

# OpenAI-compatible synthesis
OPENAI_API_KEY=
# Leave blank for OpenAI's default endpoint; include /v1 for compatible providers.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-luna

# Demo policy
RESEARCH_DEADLINE_SECONDS=20

# Optional: only needed for non-interactive Cloudflare CLI deployment
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=decision-window
