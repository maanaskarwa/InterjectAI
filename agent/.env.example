# LiveKit Cloud (server-side secrets)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=decision-window

# Inworld — rotated base64 API credential, without the `Basic ` prefix
# Used directly by livekit-plugins-inworld and the REST examples.
INWORLD_API_KEY=

# Bright Data
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Demo policy
DECISION_WINDOW_ROOM=decision-window-demo
RESEARCH_DEADLINE_SECONDS=12
